CCEffect %{
  techniques:
  - passes:
    - vert: tmp-vs:vert
      frag: tmp-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        alphaThreshold: { value: 0.5 }
        
        texture0: { value: white }
        texture1: { value: white }
        texture2: { value: white }
        texture3: { value: white }
        texture4: { value: white }
        texture5: { value: white }
        texture6: { value: white }
        texture7: { value: white }
        
        gradientColor1: { value: [1, 1, 1, 1],  editor: { type: color } }
        gradientColor2: { value: [1, 1, 1, 1],  editor: { type: color } }
        gradientColor3: { value: [1, 1, 1, 1],  editor: { type: color } }
        gradientColor4: { value: [1, 1, 1, 1],  editor: { type: color } }
        gradientColor5: { value: [1, 1, 1, 1],  editor: { type: color } }
        gradientColorRatio1: { value: 0.5, range:[0, 1, 0.01] }
        gradientColorRatio2: { value: 0.5, range:[0, 1, 0.01] }
        gradientColorRatio3: { value: 0.5, range:[0, 1, 0.01] }
        gradientColorRatio4: { value: 0.5, range:[0, 1, 0.01] }
        gradientColorRatio5: { value: 0.5, range:[0, 1, 0.01] }
        gradientAngle: { value: 0.5, range:[0, 1.57, 0.01] }

        faceColor: { value: [1, 1, 1, 1],  editor: { type: color } }
        faceDilate: { value: 0.5, range:[0, 1, 0.01] }
        faceSoftness: { value: 0.02, range:[0, 1, 0.01] }

        outlineColor1: { value: [1, 0, 1, 1],  editor: { type: color } }
        outlineColor2: { value: [1, 1, 0, 1],  editor: { type: color } }
        outlineColor3: { value: [1, 0, 0, 1],  editor: { type: color } }
        outlineColor4: { value: [1, 0, 0, 1],  editor: { type: color } }
        outlineThickness: { value: 0.1, range:[0, 1, 0.01]}

        underlayColor: { value: [0, 0, 0, 1],  editor: { type: color } }
        underlayOffsetX: { value: 0, range:[-1, 1, 0.001] }
        underlayOffsetY: { value: 0, range:[-1, 1, 0.001] }
        underlayDilate: { value: 0.5, range:[0, 1, 0.01] }
        underlaySoftness: { value: 0.1, range:[0, 1, 0.01] }

        # glowColor123: { value: [0, 1] }
        glowColor: { value: [0, 1, 0, 1] }
        glowOffset: { value: 0.5, range:[0, 1, 0.01] }
        glowInner: { value: 0.01, range:[0, 1, 0.01] }
        glowOuter: { value: 0.01, range:[0, 1, 0.01] }
        glowPower: { value: 1, range:[0, 1, 0.01] }
}%
#version 
CCProgram tmp-vs %{
precision highp float;
#include <builtin/uniforms/cc-global>
#if USE_LOCAL
    #include <builtin/uniforms/cc-local>
#endif
#if SAMPLE_FROM_RT
    #include <common/common-define>
#endif
in vec3 a_position;
in vec2 a_texCoord;
in vec4 a_color;
in vec4 a_color2;
in float a_texture_idx;

out vec4 color;
out vec4 glyphUvsOrBaseColor;
out vec2 uv0;
out float texture_idx;

vec4 vert() {
    vec4 pos = vec4(a_position, 1);
    
    #if USE_LOCAL
        pos = cc_matWorld * pos;
    #endif
    
    #if USE_PIXEL_ALIGNMENT
        pos = cc_matView * pos;
        pos.xyz = floor(pos.xyz);
        pos = cc_matProj * pos;
    #else
        pos = cc_matViewProj * pos;
    #endif
    
    uv0 = a_texCoord;
    #if SAMPLE_FROM_RT
        CC_HANDLE_RT_SAMPLE_FLIP(uv0);
    #endif
    
    color = a_color2;
    glyphUvsOrBaseColor = a_color;
    texture_idx = a_texture_idx;
    
    return pos;
}
}%

vec2 angleToUnitVector(float angleInRadians) {
return vec2(cos(angleInRadians), sin(angleInRadians));
}
CCProgram tmp-fs %{
precision highp float;
#include <builtin/internal/embedded-alpha>
#include <builtin/internal/alpha-test>

in vec4 color;
in vec4 glyphUvsOrBaseColor;
in vec2 uv0;
in vec3 pos;
in float texture_idx;

#if USE_LINEAR_GRADIENT_2
    uniform GradientColorItem2 {
        float gradientColorRatio1;
        float gradientColorRatio2;
        float gradientAngle;
        float padding;
        vec4 gradientColor1;
        vec4 gradientColor2;
    };
#endif
#if USE_LINEAR_GRADIENT_3
    uniform GradientColorItem3 {
        vec4 gradientColor3;
        float gradientColorRatio3;
    };
#endif
#if USE_LINEAR_GRADIENT_4
    uniform GradientColorItem4 {
        vec4 gradientColor4;
        float gradientColorRatio4;
    };
#endif
#if USE_LINEAR_GRADIENT_5
    uniform GradientColorItem5 {
        vec4 gradientColor5;
        float gradientColorRatio5;
    };
#endif

#if USE_TEXTURE_LEVEL_1
    uniform sampler2D texture0;
#endif
#if USE_TEXTURE_LEVEL_2
    uniform sampler2D texture1;
#endif
#if USE_TEXTURE_LEVEL_3
    uniform sampler2D texture2;
    uniform sampler2D texture3;
#endif
#if USE_TEXTURE_LEVEL_4
    uniform sampler2D texture4;
    uniform sampler2D texture5;
    uniform sampler2D texture6;
    uniform sampler2D texture7;
#endif

uniform Face {
    //Font color will be mixed with vertex color
    vec4 faceColor;
    //The thickness of the font is 0.5. The standard thickness of the font
    float faceDilate;
    //The softness of the font
    float faceSoftness;
};

#if USE_OUTLINE
    uniform Outline {
        //The stroke color will be affected by the vertex alpha value
        vec4 outlineColor1;
        vec4 outlineColor2;
        vec4 outlineColor3;
        vec4 outlineColor4;
        //Stroke thickness
        float outlineThickness;
    };
#endif

#if USE_UNDERLAY
    uniform Underlay {
        //Shadow color will be affected by the vertex alpha value
        vec4 underlayColor;
        //Shadow offset
        float underlayOffsetX;
        float underlayOffsetY;
        //Shadow thickness
        float underlayDilate;
        //Shadow softness
        float underlaySoftness;
    };
#endif

#if USE_GLOW
    uniform Glow {
        //The glow color will be affected by the vertex alpha value
        vec4 glowColor;
        //Glow offset
        float glowOffset;
        //The thickness of the glow towards the interior
        float glowInner;
        //The thickness of the glow towards the outside
        float glowOuter;
        //Glow intensity The glow intensity is the largest when the value is 1. The smaller the value, the greater the glow attenuation coefficient.
        float glowPower;
    };
#endif

float unlerp(float value, float lower, float higher) {
    float ret = (value - lower) / (higher - lower);
    return ret;
}
float projectionRelativeLength(vec2 A, vec2 B) {
    if (length(B) == 0.0) {
        return 0.0;
    };
    return (dot(A, B) / length(A)) / length(A);
}

vec4 frag() {
    float curDistance = 0.0;
    
    #if USE_UNDERLAY
        float underlayDistance = 0.0;
    #endif
    
    #if USE_TEXTURE_LEVEL_1
        if (texture_idx <= 0.0) {
            curDistance = CCSampleWithAlphaSeparated(texture0, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture0, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        }
    #endif
    #if USE_TEXTURE_LEVEL_2
        else if (texture_idx <= 1.0) {
            curDistance = CCSampleWithAlphaSeparated(texture1, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture1, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        }
    #endif
    #if USE_TEXTURE_LEVEL_3
        else if (texture_idx <= 2.0) {
            curDistance = CCSampleWithAlphaSeparated(texture2, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture2, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        } else if (texture_idx <= 3.0) {
            curDistance = CCSampleWithAlphaSeparated(texture3, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture3, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        }
    #endif
    #if USE_TEXTURE_LEVEL_4
        else if (texture_idx <= 4.0) {
            curDistance = CCSampleWithAlphaSeparated(texture4, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture4, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        } else if (texture_idx <= 5.0) {
            curDistance = CCSampleWithAlphaSeparated(texture5, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture5, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        } else if (texture_idx <= 6.0) {
            curDistance = CCSampleWithAlphaSeparated(texture6, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture6, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        } else if (texture_idx <= 7.0) {
            curDistance = CCSampleWithAlphaSeparated(texture7, uv0).a;
            #if USE_UNDERLAY
                underlayDistance = CCSampleWithAlphaSeparated(texture7, uv0 + vec2(-underlayOffsetX, underlayOffsetY)).a;
            #endif
        }
    #endif
    
    float faceValue = 1.0 - faceDilate;
    float faceDistance = smoothstep(faceValue - faceSoftness, faceValue + faceSoftness, curDistance);
    vec4 fragColor = vec4(color.rgb * faceColor.rgb, faceColor.a * faceDistance);
    
    #if USE_LINEAR_GRADIENT_2
        
        vec2 normalizedAngle = vec2(cos(gradientAngle), sin(gradientAngle));
        vec2 blUv = glyphUvsOrBaseColor.rg;
        vec2 trUv = glyphUvsOrBaseColor.ba;
        vec2 localUvWithinCurrentGlyph = vec2(0, unlerp(uv0.y, trUv.y, blUv.y));
        
        vec2 scaledAngle = vec2(0, 0);
        
        if (normalizedAngle.x > 0.0) {
            localUvWithinCurrentGlyph.x = unlerp(uv0.x, blUv.x, trUv.x);
            scaledAngle = normalizedAngle * projectionRelativeLength(normalizedAngle, vec2(1, 1));
        }else {
            localUvWithinCurrentGlyph.x = -(1.0 - unlerp(uv0.x, blUv.x, trUv.x));
            scaledAngle = normalizedAngle * projectionRelativeLength(normalizedAngle, vec2(-1, 1));
        }
        
        float gradientPosition = projectionRelativeLength(scaledAngle, localUvWithinCurrentGlyph);
        vec3 black = vec3(0, 0, 0);
        vec3 white = vec3(1, 1, 1);
        fragColor.rgb = mix(black, white, gradientPosition).rgb;
        
        float colorAspect;
        
        if (gradientPosition < gradientColorRatio1) {
            fragColor.rgb =gradientColor1.rgb;
        } else if (gradientPosition < gradientColorRatio2) {
            colorAspect = unlerp(gradientPosition,gradientColorRatio1,gradientColorRatio2);
            fragColor.rgb = mix(gradientColor1, gradientColor2, colorAspect).rgb;
        }
        #if USE_LINEAR_GRADIENT_3
            else if (gradientPosition < gradientColorRatio3) {
                colorAspect = unlerp(gradientPosition,gradientColorRatio2,gradientColorRatio3);
                fragColor.rgb = mix(gradientColor2, gradientColor3, colorAspect).rgb;
            }
        #endif
        #if USE_LINEAR_GRADIENT_4
            else if (gradientPosition < gradientColorRatio4) {
                colorAspect = unlerp(gradientPosition,gradientColorRatio3,gradientColorRatio4);
                fragColor.rgb = mix(gradientColor3, gradientColor4, colorAspect).rgb;
            }
        #endif
        #if USE_LINEAR_GRADIENT_5
            else if (gradientPosition < gradientColorRatio5) {
                colorAspect = unlerp(gradientPosition,gradientColorRatio4,gradientColorRatio5);
                fragColor.rgb = mix(gradientColor4, gradientColor5, colorAspect).rgb;
            }
        #endif
        else if (gradientPosition < 1.0){
            vec4 lastColor =vec4(gradientColor2.rgb,1);
            #if USE_LINEAR_GRADIENT_3
                lastColor.rgb = gradientColor3.rgb;
            #endif 
            #if USE_LINEAR_GRADIENT_4
            lastColor.rgb = gradientColor4.rgb;
            #endif 
            #if USE_LINEAR_GRADIENT_5
            lastColor.rgb = gradientColor5.rgb;
            #endif 
            fragColor.rgb = lastColor.rgb;
        }
    #endif

        #if USE_VERTEX_GRADIENT
        fragColor.rgb = mix(fragColor.rgb,color.rgb,color.a);
        #endif

        #if USE_OUTLINE
            float outEdge1 = faceValue - outlineThickness;
            float outEdge2 = faceValue;
            float outlineDistance = smoothstep( outEdge1 - faceSoftness, 
                                                outEdge1 + faceSoftness,
                                                curDistance) 
                                    - smoothstep(   outEdge2 - faceSoftness,
                                                    outEdge2 + faceSoftness,
                                                    curDistance);
            float faceClip = step(0.001, faceColor.a);
            float outClip = step(0.001, outlineColor1.a);
            float outlineRelativeAspect = unlerp(curDistance,outEdge1,outEdge2);
            vec4 outlineColor = outlineColor1;
            if(outlineRelativeAspect>0.5){
                outlineColor = outlineColor2;
            }
            fragColor.rgb = color.rgb * fragColor.rgb * faceDistance * faceClip + outlineColor.rgb * outlineDistance * outClip;
            fragColor.a = faceColor.a * faceDistance + outlineColor1.a * outlineDistance;
        #endif
        
        #if USE_UNDERLAY
            float underlayValue = 1.0 - underlayDilate;
            float underlayAlpha = smoothstep(underlayValue - underlaySoftness, underlayValue + underlaySoftness, underlayDistance);
            vec4 finalUnderlayColor = vec4(underlayColor.rgb, underlayAlpha * underlayColor.a);
            
            if (fragColor.a < 1.0 && finalUnderlayColor.a > 0.0) {
                fragColor.rgb *= fragColor.a;
                fragColor += finalUnderlayColor * (1.0 - fragColor.a);
            }
        #endif
        
        #if USE_GLOW
            float delta = curDistance - glowOffset;
            float deltaFactor = step(0.0, delta);
            float attenuation = pow(abs(delta), glowPower) * 2.0;
            float alpha = clamp(max(glowInner - attenuation, 0.0) / glowInner, 0.0, 1.0) * deltaFactor + clamp((glowOuter - attenuation) / glowOuter, 0.0, 1.0) * (1.0 - deltaFactor);
            fragColor += glowColor * glowColor.a * alpha;
        #endif
        
        ALPHA_TEST(fragColor);
        return fragColor;
    }
    
}%
